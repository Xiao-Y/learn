<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.billow.system.dao.MailTemplateDao">

        <!-- 开启二级缓存 -->
        <!-- 注意：默认为 flushCache="true" useCache="true" -->
        <!-- 1.自定义查询方法时，必须 flushCache="false" useCache="false"， -->
        <!-- 2.更新，添加，删除时，必须 flushCache="true" useCache="true" 或者不添加 -->
        <!-- 3.请务修改 cache-ref 中的配置 -->
        <cache-ref namespace="com.billow.system.dao.MailTemplateDao"/>
        <!-- 通用查询映射结果 -->
        <resultMap id="BaseResultMap" type="com.billow.system.pojo.po.MailTemplatePo">
                <result column="id" property="id"/>
                <result column="valid_ind" property="validInd"/>
                <result column="create_time" property="createTime"/>
                <result column="creator_code" property="creatorCode"/>
                <result column="update_time" property="updateTime"/>
                <result column="updater_code" property="updaterCode"/>
                    <result column="mail_code" property="mailCode"/>
                    <result column="mail_type" property="mailType"/>
                    <result column="data_sources" property="dataSources"/>
                    <result column="subject" property="subject"/>
                    <result column="to_emails" property="toEmails"/>
                    <result column="mail_temp" property="mailTemp"/>
                    <result column="mail_markdown" property="mailMarkdown"/>
                    <result column="run_sql" property="runSql"/>
                    <result column="single_result" property="singleResult"/>
                    <result column="template_path" property="templatePath"/>
                    <result column="description" property="description"/>
                    <result column="attachment" property="attachment"/>
                    <result column="template_name" property="templateName"/>
        </resultMap>

        <!-- 通用查询结果列 -->
        <sql id="Base_Column_List">
                id,
                valid_ind,
                create_time,
                creator_code,
                update_time,
                updater_code,
            mail_code, mail_type, data_sources, subject, to_emails, mail_temp, mail_markdown, run_sql, single_result, template_path, description, attachment, template_name
        </sql>

</mapper>
