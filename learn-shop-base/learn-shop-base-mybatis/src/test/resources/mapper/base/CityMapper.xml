<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.billow.system.dao.CityDao">

        <!-- 开启二级缓存 -->
        <!-- 注意：默认为 flushCache="true" useCache="true" -->
        <!-- 1.自定义查询方法时，必须 flushCache="false" useCache="false"， -->
        <!-- 2.更新，添加，删除时，必须 flushCache="true" useCache="true" 或者不添加 -->
        <!-- 3.请务修改 cache-ref 中的配置 -->
        <cache-ref namespace="com.billow.system.dao.CityDao"/>
        <!-- 通用查询映射结果 -->
        <resultMap id="BaseResultMap" type="com.billow.system.pojo.po.CityPo">
                <result column="id" property="id"/>
                <result column="create_time" property="createTime"/>
                <result column="creator_code" property="creatorCode"/>
                <result column="update_time" property="updateTime"/>
                <result column="updater_code" property="updaterCode"/>
                <result column="valid_ind" property="validInd"/>
                    <result column="city_id" property="cityId"/>
                    <result column="parent_city_id" property="parentCityId"/>
                    <result column="level_type" property="levelType"/>
                    <result column="city_code" property="cityCode"/>
                    <result column="name" property="name"/>
                    <result column="short_name" property="shortName"/>
                    <result column="pin_yin" property="pinYin"/>
                    <result column="merger_name" property="mergerName"/>
                    <result column="zip_code" property="zipCode"/>
                    <result column="lat" property="lat"/>
                    <result column="lng" property="lng"/>
        </resultMap>

        <!-- 通用查询结果列 -->
        <sql id="Base_Column_List">
                id,
                create_time,
                creator_code,
                update_time,
                updater_code,
                valid_ind,
            city_id, parent_city_id, level_type, city_code, name, short_name, pin_yin, merger_name, zip_code, lat, lng
        </sql>

</mapper>
